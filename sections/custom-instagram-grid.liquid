<section class="custom-ig-grid section-{{ section.id }}">
  <div class="custom-ig-grid__inner">
    {% if section.settings.heading != blank %}
      <div class="custom-ig-grid__header">
        <h2>{{ section.settings.heading }}</h2>
        {% if section.settings.handle != blank %}
          <a href="{{ section.settings.instagram_url }}" target="_blank">
            {{ section.settings.handle }}
          </a>
        {% endif %}
      </div>
    {% endif %}

    <div id="ig-feed-{{ section.id }}" class="custom-ig-grid__feed"></div>
  </div>
</section>

<style>
  .section-{{ section.id }} {
    background: {{ section.settings.background_color }};
    padding: {{ section.settings.padding_top }}px {{ section.settings.padding_x }}px {{ section.settings.padding_bottom }}px;
  }

  .section-{{ section.id }} .custom-ig-grid__inner {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
  }

  .section-{{ section.id }} .custom-ig-grid__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid rgba(0,0,0,.25);
    margin-bottom: 20px;
  }

  .section-{{ section.id }} h2,
  .section-{{ section.id }} a {
    margin: 0;
    color: {{ section.settings.text_color }};
    text-decoration: none;
    letter-spacing: .18em;
    text-transform: uppercase;
  }

  .section-{{ section.id }} h2 {
    font-size: 28px;
    font-weight: 400;
    padding-bottom: 8px;
    border-bottom: 2px solid {{ section.settings.text_color }};
    margin-bottom: -1px;
  }

  .section-{{ section.id }} .custom-ig-grid__feed {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    grid-template-rows: repeat(2, 1fr);
    gap: {{ section.settings.gap }}px;
  }

  .section-{{ section.id }} .custom-ig-grid__item {
    display: block;
    overflow: hidden;
    aspect-ratio: 1 / 1;
  }

  .section-{{ section.id }} .custom-ig-grid__item:first-child {
    grid-column: 1 / span 2;
    grid-row: 1 / span 2;
  }

  .section-{{ section.id }} .custom-ig-grid__item img,
  .section-{{ section.id }} .custom-ig-grid__item video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media screen and (max-width: 749px) {
    .section-{{ section.id }} .custom-ig-grid__feed {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: auto;
      gap: 10px;
    }

    .section-{{ section.id }} .custom-ig-grid__item:first-child {
      grid-column: 1 / span 2;
      grid-row: auto;
    }

    .section-{{ section.id }} .custom-ig-grid__header {
      align-items: flex-end;
    }

    .section-{{ section.id }} h2 {
      font-size: 22px;
    }
  }
</style>

<script>
  async function loadInstagramFeed{{ section.id | replace: '-', '' }}() {
    const feed = document.getElementById('ig-feed-{{ section.id }}');
    if (!feed) return;

    const token = '{{ section.settings.access_token }}';
    const limit = 7;

    if (!token) {
      feed.innerHTML = '<p>Instagram access token missing.</p>';
      return;
    }

    try {
      const response = await fetch(`https://graph.instagram.com/me/media?fields=id,caption,media_type,media_url,permalink,thumbnail_url&limit=${limit}&access_token=${token}`);
      const data = await response.json();

      if (!data.data) return;

      feed.innerHTML = data.data.map((item) => {
        const imageUrl = item.media_type === 'VIDEO' ? item.thumbnail_url : item.media_url;

        return `
          <a class="custom-ig-grid__item" href="${item.permalink}" target="_blank" rel="noopener">
            <img src="${imageUrl}" alt="${item.caption ? item.caption.replace(/"/g, '&quot;') : 'Instagram post'}" loading="lazy">
          </a>
        `;
      }).join('');
    } catch (error) {
      console.error('Instagram feed error:', error);
    }
  }

  document.addEventListener('DOMContentLoaded', loadInstagramFeed{{ section.id | replace: '-', '' }});
  document.addEventListener('shopify:section:load', loadInstagramFeed{{ section.id | replace: '-', '' }});
</script>

{% schema %}
{
  "name": "Custom Instagram Grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "SHOP THE FEED"
    },
    {
      "type": "text",
      "id": "handle",
      "label": "Instagram handle",
      "default": "@FANSEHAIR"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "textarea",
      "id": "access_token",
      "label": "Instagram Access Token"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#eafaff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#121212"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max width",
      "min": 900,
      "max": 1800,
      "step": 50,
      "default": 1400
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Grid gap",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_x",
      "label": "Side padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 32
    }
  ],
  "presets": [
    {
      "name": "Custom Instagram Grid"
    }
  ]
}
{% endschema %}